    <script>
        (function() {
            const STORAGE_KEY = 'pixelforge_waitlist';
            const nav = document.getElementById('nav');
            const form = document.getElementById('waitlistForm');
            const emailInput = document.getElementById('emailInput');
            const submitBtn = document.getElementById('submitBtn');
            const successMsg = document.getElementById('successMsg');
            const errorMsg = document.getElementById('errorMsg');
            const countEl = document.getElementById('waitlistCount');

            // ── Load & display waitlist count ──
            function getWaitlist() {
                try {
                    const data = localStorage.getItem(STORAGE_KEY);
                    return data ? JSON.parse(data) : [];
                } catch (e) {
                    return [];
                }
            }

            function saveWaitlist(list) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
            }

            function updateCount() {
                const list = getWaitlist();
                countEl.textContent = list.length;
            }

            function isEmailRegistered(email) {
                const list = getWaitlist();
                return list.some(entry => entry.email.toLowerCase() === email.toLowerCase());
            }

            // ── Handle form submission ──
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const email = emailInput.value.trim();

                // Reset messages
                successMsg.classList.remove('visible');
                errorMsg.classList.remove('visible');

                // Basic validation
                if (!email) {
                    errorMsg.textContent = 'Please enter a valid email address.';
                    errorMsg.classList.add('visible');
                    return;
                }

                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    errorMsg.textContent = 'Hmm, that doesn\'t look like a valid email. Try again.';
                    errorMsg.classList.add('visible');
                    return;
                }

                // Check duplicate
                if (isEmailRegistered(email)) {
                    errorMsg.textContent = 'You\'re already on the list! We\'ll be in touch soon.';
                    errorMsg.classList.add('visible');
                    return;
                }

                // Save to localStorage
                submitBtn.disabled = true;
                submitBtn.textContent = 'Saving...';

                // Simulate slight delay for UX
                setTimeout(() => {
                    const list = getWaitlist();
                    list.push({
                        email: email,
                        timestamp: new Date().toISOString()
                    });
                    saveWaitlist(list);
                    updateCount();
                    emailInput.value = '';
                    successMsg.classList.add('visible');
                    submitBtn.disabled = false;
                    submitBtn.textContent = '🔒 Secure My Spot';

                    // Hide success message after 6 seconds
                    setTimeout(() => {
                        successMsg.classList.remove('visible');
                    }, 6000);
                }, 400);
            });

            // ── Nav scroll effect ──
            function handleScroll() {
                if (window.scrollY > 40) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
            }
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll(); // initial check

            // ── Smooth scroll for anchor links ──
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    const target = document.querySelector(targetId);
                    if (target) {
                        e.preventDefault();
                        const navHeight = nav.offsetHeight + 20;
                        const top = target.getBoundingClientRect().top + window.pageYOffset -
                            navHeight;
                        window.scrollTo({ top, behavior: 'smooth' });
                    }
                });
            });

            // ── Initialize count ──
            updateCount();

            console.log(
                '%c🔮 PixelForge Waitlist Ready %c| %cEmails stored in your browser\'s localStorage.',
                'font-weight:bold;color:#7c5cfc;',
                '',
                'color:#9494b0;'
            );
        })();
    </script>
